# -----------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is gitignored - never commit real keys.
#
# These are the only two variables the browser bundle ever sees. The publishable
# key is safe to ship: it is the same `anon` role that RLS already restricts, so
# exposing it grants nothing. The secret key is deliberately NOT here - nothing
# in this app is allowed to use it from the client.
# -----------------------------------------------------------------------------

# Project URL from the Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://oqqzzyombtcjvlqbjvla.supabase.co

# New-style publishable key (sb_publishable_...). Safe to expose to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-side only. Used by scripts/apply-migrations.mjs to run DDL.
# NOTE: if you are on an IPv4-only network the direct host
# (db.<ref>.supabase.co) will not resolve - it is IPv6-only. Use the pooler:
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Find your region from Project Settings -> Database -> Connection string.
DATABASE_URL=postgresql://postgres.oqqzzyombtcjvlqbjvla:your-password@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
